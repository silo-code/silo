{
  "name": "@silo-code/sdk",
  "version": "0.44.0",
  "description": "The public, types-first SDK for building Silo extensions — the only surface third-party extensions import.",
  "license": "MIT",
  "author": "Dave Weaver",
  "homepage": "https://github.com/silo-code/silo/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silo-code/silo.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "silo",
    "silo-code",
    "extension",
    "sdk",
    "editor"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-extensions.mjs",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "vitest": "^4.1.7"
  }
}
